COMPOSE_PROJECT_NAME=teamcity-current
TC_HOSTNAME=your-local-hostname # Change to the actual host name. Only required for DSL compilation on agents.
TC_VERSION=2026.2
TC_HOST_PORT=8110
TC_HOST_HTTPS_PORT=8443
TC_HEAP=2g
TC_MEM_LIMIT=4G
TC_MEM_RESERVATION=2G
POSTGRES_VERSION=18 # use 15 for TeamCity versions older than 2023.11
POSTGRES_DATA_DIR=/var/lib/postgresql # use /var/lib/postgresql/data for postgres 15
P4_TAG=26.1
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
NGINX_VERSION=alpine3.23
SONARQUBE_VERSION=26.4.0.121862-community
