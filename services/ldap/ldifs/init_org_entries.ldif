version: 1

# Test users and groups for the TeamCity LDAP integration.
#
# The filename overrides the image's own init_org_entries.ldif, which would otherwise seed sample
# employees that TeamCity's subtree-wide user filter would pick up. Applied once, on the first start
# of an empty volume. ${LDAP_INIT_ORG_DN} is substituted by the image.
#
# Users sit directly under the base DN because ldap-config.properties keys them by cn. ou=Groups
# already exists (init_org_tree.ldif creates it), so it is referenced, not created.

##############################
# Users
##############################
dn: cn=tc_admin,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: tc_admin
sn: Administrator
givenName: TeamCity
displayName: TeamCity Administrator
mail: tc_admin@teamcity.test
userPassword: teamcity

dn: cn=maintainer,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: maintainer
sn: Maintainer
givenName: Project
displayName: Project Maintainer
mail: maintainer@teamcity.test
userPassword: teamcity

dn: cn=developer,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: developer
sn: Developer
givenName: Regular
displayName: Regular Developer
mail: developer@teamcity.test
userPassword: teamcity

##############################
# Groups
##############################
# Group sync is off by default in ldap-config.properties; these exist so it can be switched on.
# groupOfUniqueNames holds full DNs, which is what TeamCity needs to resolve members.
# "maintaners" is misspelled in the directory this replaced - kept verbatim.
dn: cn=admins,ou=Groups,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: groupOfUniqueNames
cn: admins
description: TeamCity administrators
uniqueMember: cn=tc_admin,${LDAP_INIT_ORG_DN}

dn: cn=maintaners,ou=Groups,${LDAP_INIT_ORG_DN}
objectClass: top
objectClass: groupOfUniqueNames
cn: maintaners
description: Project maintainers
uniqueMember: cn=maintainer,${LDAP_INIT_ORG_DN}
uniqueMember: cn=tc_admin,${LDAP_INIT_ORG_DN}
